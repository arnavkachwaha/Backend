    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Django Server",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",  // Path to your Django project's manage.py
            "args": [
                "runserver",  // Runs the Django development server
                // "10.243.69.100:8000"  // Optional: tufts-secure
            ],
            "django": true,
            "console": "integratedTerminal"
        }
    ]
}